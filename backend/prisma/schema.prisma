generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model announcement_classes {
  announcement_id String        @db.Uuid
  class_id        String        @db.Uuid
  announcements   announcements @relation(fields: [announcement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  classes         classes       @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([announcement_id, class_id])
}

model announcements {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id            String                 @db.Uuid
  title                String
  message              String
  is_urgent            Boolean?               @default(false)
  teacher_id           String                 @db.Uuid
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  announcement_classes announcement_classes[]
  schools              schools                @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles             profiles               @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model attendance {
  id                                       String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id                                String                 @db.Uuid
  student_id                               String                 @db.Uuid
  attendance_date                          DateTime               @db.Date
  status                                   attendance_status_enum
  taken_by                                 String                 @db.Uuid
  recorded_at                              DateTime?              @default(now()) @db.Timestamptz(6)
  schools                                  schools                @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_attendance_student_idToprofiles profiles               @relation("attendance_student_idToprofiles", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles_attendance_taken_byToprofiles   profiles               @relation("attendance_taken_byToprofiles", fields: [taken_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id, attendance_date], map: "idx_attendance_tenant_date")
}

model classes {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id            String                 @db.Uuid
  name                 String
  grade_level_id       Int
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  announcement_classes announcement_classes[]
  grade_levels         grade_levels           @relation(fields: [grade_level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools              schools                @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  engagement_sessions  engagement_sessions[]
  files                files[]
  student_details      student_details[]
  teacher_classes      teacher_classes[]
  tests                tests[]
  timetable_days       timetable_days[]
  voice_notes          voice_notes[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model documents {
  id        Int                    @id @default(autoincrement())
  content   String
  metadata  Json?                  @default("{}")
  embedding Unsupported("vector")?

  @@index([embedding])
}

model exam_types {
  id         Int            @id @default(autoincrement())
  school_id  String         @db.Uuid
  name       String
  type       exam_type_enum
  created_at DateTime?      @default(now()) @db.Timestamptz(6)
  schools    schools        @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tests      tests[]
}

model file_categories {
  id         Int       @id @default(autoincrement())
  school_id  String    @db.Uuid
  name       String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  schools    schools   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  files      files[]
}

model files {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id           String                @db.Uuid
  file_title          String
  category_id         Int?
  class_id            String                @db.Uuid
  grade_subject_id    String                @db.Uuid
  storage_url         String
  teacher_id          String                @db.Uuid
  download_count      Int?                  @default(0)
  file_type           String?               @default("pdf")
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  engagement_sessions engagement_sessions[]
  file_categories     file_categories?      @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  classes             classes               @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grade_subjects      grade_subjects        @relation(fields: [grade_subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools             schools               @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles            profiles              @relation(fields: [teacher_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pdf_annotations     pdf_annotations[]

  @@index([school_id], map: "idx_files_tenant")
}

model grade_levels {
  id             Int              @id @default(autoincrement())
  school_id      String           @db.Uuid
  name           String
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  classes        classes[]
  schools        schools          @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grade_subjects grade_subjects[]
}

model grade_subjects {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id         String              @db.Uuid
  grade_level_id    Int
  subject_master_id String              @db.Uuid
  files             files[]
  grade_levels      grade_levels        @relation(fields: [grade_level_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools           schools             @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects_master   subjects_master     @relation(fields: [subject_master_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacher_subjects  teacher_subjects[]
  tests             tests[]
  timetable_periods timetable_periods[]
  voice_notes       voice_notes[]
}

model notifications {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id         String?   @db.Uuid
  recipient_id      String    @db.Uuid
  title             String
  message           String
  notification_type String?
  source_id         String?   @db.Uuid
  target_url        String?
  is_read           Boolean?  @default(false)
  is_urgent         Boolean?  @default(false)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  profiles          profiles  @relation(fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools           schools?  @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model profiles {
  id                                         String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id                                  String?                      @db.Uuid
  email                                      String                       @unique
  password_hash                              String
  role_id                                    Int                          @db.SmallInt
  name                                       String?
  avatar_url                                 String?
  is_verified                                Boolean?                     @default(false)
  is_first_login                             Boolean?                     @default(false)
  verification_token                         String?
  created_at                                 DateTime?                    @default(now()) @db.Timestamptz(6)
  announcements                              announcements[]
  attendance_attendance_student_idToprofiles attendance[]                 @relation("attendance_student_idToprofiles")
  attendance_attendance_taken_byToprofiles   attendance[]                 @relation("attendance_taken_byToprofiles")
  engagement_analytics                       engagement_analytics[]
  engagement_sessions                        engagement_sessions[]
  files                                      files[]
  notifications                              notifications[]
  user_roles                                 user_roles                   @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schools                                    schools?                     @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quiz_history                               quiz_history[]
  student_details                            student_details?
  student_responses                          student_responses[]
  teacher_classes                            teacher_classes[]
  teacher_details                            teacher_details?
  teacher_efficiency_metrics                 teacher_efficiency_metrics[]
  teacher_subjects                           teacher_subjects[]
  term_engagement_summary                    term_engagement_summary[]
  test_submissions                           test_submissions[]
  tests                                      tests[]
  timetable_periods                          timetable_periods[]
  voice_notes                                voice_notes[]

  @@index([school_id], map: "idx_profiles_school")
}

model question_options {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  question_id  String    @db.Uuid
  option_index Int
  option_text  String
  questions    questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model questions {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  test_id              String             @db.Uuid
  question_text        String
  marks                Int
  chapter              String?
  topic                String?
  correct_option_index Int?
  question_type        question_type_enum @default(MCQ)
  expected_answer_text String?
  created_at           DateTime?          @default(now()) @db.Timestamptz(6)
  question_options     question_options[]
  tests                tests              @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student_answers      student_answers[]
}

model schools {
  id                         String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                       String
  created_at                 DateTime?                    @default(now()) @db.Timestamptz(6)
  admin_profile_id           String?                      @db.Uuid
  logo_url                   String?
  announcements              announcements[]
  attendance                 attendance[]
  classes                    classes[]
  engagement_analytics       engagement_analytics[]
  engagement_sessions        engagement_sessions[]
  exam_types                 exam_types[]
  file_categories            file_categories[]
  files                      files[]
  grade_levels               grade_levels[]
  grade_subjects             grade_subjects[]
  notifications              notifications[]
  pdf_annotations            pdf_annotations[]
  profiles                   profiles[]
  quiz_history               quiz_history[]
  subjects_master            subjects_master[]
  teacher_classes            teacher_classes[]
  teacher_efficiency_metrics teacher_efficiency_metrics[]
  teacher_subjects           teacher_subjects[]
  term_engagement_summary    term_engagement_summary[]
  tests                      tests[]
  timetable_days             timetable_days[]
  timetable_periods          timetable_periods[]
  voice_notes                voice_notes[]
}

model student_answers {
  id                            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  submission_id                 String           @db.Uuid
  question_id                   String           @db.Uuid
  student_selected_option_index Int?
  subjective_answer_text        String?
  marks_awarded                 Int?
  questions                     questions        @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  test_submissions              test_submissions @relation(fields: [submission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model student_details {
  profile_id     String    @id @db.Uuid
  roll_number    String?
  admission_date DateTime? @db.Date
  parent_contact String?   @db.VarChar(15)
  class_id       String?   @db.Uuid
  classes        classes?  @relation(fields: [class_id], references: [id], onUpdate: NoAction, map: "fk_student_class")
  profiles       profiles  @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model subjects_master {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id      String           @db.Uuid
  name           String
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  grade_subjects grade_subjects[]
  schools        schools          @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model teacher_classes {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id  String    @db.Uuid
  teacher_id String    @db.Uuid
  class_id   String    @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  classes    classes   @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools    schools   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles   profiles  @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model teacher_details {
  profile_id     String    @id @db.Uuid
  bio            String?
  specialization String?
  joining_date   DateTime? @db.Date
  profiles       profiles  @relation(fields: [profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model teacher_subjects {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id        String         @db.Uuid
  teacher_id       String         @db.Uuid
  grade_subject_id String         @db.Uuid
  assigned_at      DateTime?      @default(now()) @db.Timestamptz(6)
  grade_subjects   grade_subjects @relation(fields: [grade_subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools          schools        @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         profiles       @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model test_submissions {
  id                   String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  test_id              String            @db.Uuid
  student_id           String            @db.Uuid
  submitted_at         DateTime?         @default(now()) @db.Timestamptz(6)
  is_graded            Boolean?          @default(false)
  total_marks_obtained Int?
  student_answers      student_answers[]
  profiles             profiles          @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tests                tests             @relation(fields: [test_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model tests {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id        String             @db.Uuid
  title            String
  description      String?
  duration_minutes Int
  is_published     Boolean?           @default(false)
  class_id         String             @db.Uuid
  grade_subject_id String             @db.Uuid
  exam_type_id     Int
  teacher_id       String             @db.Uuid
  due_date         DateTime?          @db.Timestamptz(6)
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  questions        questions[]
  test_submissions test_submissions[]
  classes          classes            @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exam_types       exam_types         @relation(fields: [exam_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grade_subjects   grade_subjects     @relation(fields: [grade_subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools          schools            @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         profiles           @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([school_id], map: "idx_tests_tenant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model timetable_days {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id         String              @db.Uuid
  class_id          String              @db.Uuid
  day_of_week       Int                 @db.SmallInt
  classes           classes             @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools           schools             @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  timetable_periods timetable_periods[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model timetable_periods {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id        String         @db.Uuid
  timetable_day_id String         @db.Uuid
  period_number    Int            @db.SmallInt
  subject_id       String         @db.Uuid
  teacher_id       String         @db.Uuid
  start_time       DateTime       @db.Time(6)
  end_time         DateTime       @db.Time(6)
  room             String?
  schools          schools        @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grade_subjects   grade_subjects @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         profiles       @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  timetable_days   timetable_days @relation(fields: [timetable_day_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_roles {
  id       Int        @id @db.SmallInt
  role     String     @unique
  profiles profiles[]
}

model voice_notes {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id        String         @db.Uuid
  title            String
  storage_url      String
  duration_seconds Int
  file_size_bytes  BigInt
  class_id         String         @db.Uuid
  grade_subject_id String         @db.Uuid
  teacher_id       String         @db.Uuid
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  classes          classes        @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  grade_subjects   grade_subjects @relation(fields: [grade_subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools          schools        @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         profiles       @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model quiz_history {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id      String    @db.Uuid
  teacher_id     String    @db.Uuid
  subject        String?   @db.VarChar(100)
  topic          String    @db.VarChar(200)
  difficulty     String?   @db.VarChar(20)
  question_count Int
  questions      Json
  quiz_metadata  Json?
  used_count     Int?      @default(0)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  schools        schools   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quiz_history_school")
  profiles       profiles  @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_quiz_history_teacher")

  @@index([teacher_id, subject], map: "idx_quiz_history_teacher_subject")
  @@index([school_id], map: "idx_quiz_history_tenant")
}

model pdf_annotations {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  file_id         String    @db.Uuid
  school_id       String    @db.Uuid
  page_number     Int
  annotation_data Json
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  files           files     @relation(fields: [file_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools         schools   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([file_id], map: "idx_pdf_annotations_file")
  @@index([school_id], map: "idx_pdf_annotations_tenant")
}

model engagement_analytics {
  id                   String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  session_id           String              @db.Uuid
  student_id           String              @db.Uuid
  school_id            String              @db.Uuid
  total_questions      Int?                @default(0)
  questions_answered   Int?                @default(0)
  questions_correct    Int?                @default(0)
  total_points_earned  Int?                @default(0)
  avg_response_time_ms Int?
  participation_rate   Decimal?            @default(0.00) @db.Decimal(5, 2)
  accuracy_rate        Decimal?            @default(0.00) @db.Decimal(5, 2)
  engagement_score     Decimal?            @default(0.00) @db.Decimal(5, 2)
  updated_at           DateTime?           @default(now()) @db.Timestamptz(6)
  schools              schools             @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  engagement_sessions  engagement_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles             profiles            @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, student_id], map: "unique_session_student")
  @@index([school_id, student_id], map: "idx_engagement_analytics_school_student")
  @@index([session_id], map: "idx_engagement_analytics_session")
}

model engagement_sessions {
  id                   String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  school_id            String                     @db.Uuid
  teacher_id           String                     @db.Uuid
  class_id             String                     @db.Uuid
  file_id              String?                    @db.Uuid
  session_name         String?                    @db.VarChar(255)
  status               engagement_session_status? @default(active)
  started_at           DateTime?                  @default(now()) @db.Timestamptz(6)
  ended_at             DateTime?                  @db.Timestamptz(6)
  created_at           DateTime?                  @default(now()) @db.Timestamptz(6)
  engagement_analytics engagement_analytics[]
  classes              classes                    @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  files                files?                     @relation(fields: [file_id], references: [id], onUpdate: NoAction)
  schools              schools                    @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles             profiles                   @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pop_questions        pop_questions[]

  @@index([class_id, status], map: "idx_engagement_sessions_class_status")
  @@index([file_id], map: "idx_engagement_sessions_file")
  @@index([school_id], map: "idx_engagement_sessions_school")
  @@index([teacher_id], map: "idx_engagement_sessions_teacher")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pop_questions {
  id                  String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  session_id          String              @db.Uuid
  question_text       String
  option_a            String
  option_b            String
  option_c            String
  option_d            String
  correct_option      String              @db.Char(1)
  time_limit_seconds  Int?                @default(30)
  points              Int?                @default(10)
  sent_at             DateTime?           @default(now()) @db.Timestamptz(6)
  expires_at          DateTime            @db.Timestamptz(6)
  created_at          DateTime?           @default(now()) @db.Timestamptz(6)
  engagement_sessions engagement_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student_responses   student_responses[]

  @@index([session_id, sent_at(sort: Desc)], map: "idx_pop_questions_session")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model student_responses {
  id               String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  question_id      String        @db.Uuid
  student_id       String        @db.Uuid
  selected_option  String        @db.Char(1)
  response_time_ms Int
  is_correct       Boolean
  points_earned    Int?          @default(0)
  submitted_at     DateTime?     @default(now()) @db.Timestamptz(6)
  pop_questions    pop_questions @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         profiles      @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([question_id, student_id], map: "unique_student_question")
  @@index([question_id], map: "idx_student_responses_question")
  @@index([student_id], map: "idx_student_responses_student")
}

model teacher_efficiency_metrics {
  id                        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  teacher_id                String    @db.Uuid
  school_id                 String    @db.Uuid
  term_id                   String?   @db.VarChar(50)
  academic_year             String?   @db.VarChar(20)
  total_sessions_conducted  Int?      @default(0)
  total_questions_sent      Int?      @default(0)
  avg_class_participation   Decimal?  @default(0.00) @db.Decimal(5, 2)
  avg_class_accuracy        Decimal?  @default(0.00) @db.Decimal(5, 2)
  avg_engagement_score      Decimal?  @default(0.00) @db.Decimal(5, 2)
  combined_efficiency_score Decimal?  @default(0.00) @db.Decimal(5, 2)
  updated_at                DateTime? @default(now()) @db.Timestamptz(6)
  schools                   schools   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles                  profiles  @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teacher_id, term_id], map: "unique_teacher_term")
  @@index([school_id, academic_year], map: "idx_teacher_efficiency_school_year")
}

model term_engagement_summary {
  id                     String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  student_id             String    @db.Uuid
  school_id              String    @db.Uuid
  term_id                String?   @db.VarChar(50)
  academic_year          String?   @db.VarChar(20)
  total_sessions         Int?      @default(0)
  total_questions        Int?      @default(0)
  questions_answered     Int?      @default(0)
  questions_correct      Int?      @default(0)
  avg_participation_rate Decimal?  @default(0.00) @db.Decimal(5, 2)
  avg_accuracy_rate      Decimal?  @default(0.00) @db.Decimal(5, 2)
  avg_engagement_score   Decimal?  @default(0.00) @db.Decimal(5, 2)
  updated_at             DateTime? @default(now()) @db.Timestamptz(6)
  schools                schools   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles               profiles  @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, term_id], map: "unique_student_term")
  @@index([school_id, academic_year], map: "idx_term_summary_school_year")
}

